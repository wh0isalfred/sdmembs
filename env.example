# Copy this file to .env.local for local development, and set the same
# variables in Vercel's Project Settings → Environment Variables for
# production. Never commit a file containing real values.

# Resend API key (https://resend.com) — used server-side only, in
# api/contact.js. Never exposed to the browser.
RESEND_API_KEY=

# The inbox that contact-form submissions should be delivered to.
CONTACT_TO_EMAIL=sanddmembs@gmail.com

# The "from" address Resend sends as. For deliverability, this should be an
# address on a domain you've verified in Resend's dashboard (Settings →
# Domains) — sending as a Gmail address you don't control the DNS for will
# likely be rejected or marked as spam. Using Resend's shared sandbox
# address (onboarding@resend.dev) works for testing before a domain is
# verified, but is not meant for production use.
CONTACT_FROM_EMAIL=
